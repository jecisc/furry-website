---
import Layout from '../layouts/Layout.astro';
import Gallery from '../components/Gallery.astro';
import Hoard from '../components/Hoard.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SocialIcon from '../components/SocialIcon.astro';
import Spotlight from '../components/Spotlight.astro';
import content from '../data/content.json';
import { Image, getImage } from 'astro:assets';
import { artworks, artworkById } from '../data/artworks';

const heroPiece = artworkById('watercolour-portrait');
/* The portrait frame is at most 26rem wide, and almost the full width on phones */
const heroWidths = [450, 900];
const heroSizes = '(max-width: 50rem) 90vw, 26rem';
/* The portrait at the top is picked at random among these on each visit, by the script next to it */
const heroChoices = await Promise.all(
	['yacrical-hoodie', 'banana-sinotus', 'watercolour-portrait', 'bre-hoodie', 'falvie-jecisc']
		.map((id) => artworkById(id))
		.filter((piece) => piece !== undefined)
		.map(async (piece) => {
			const isMine = piece.artist === content.name;
			const resized = await getImage({ src: piece.image, widths: heroWidths, sizes: heroSizes });
			return {
				src: resized.src,
				srcset: resized.srcSet.attribute,
				width: piece.image.width,
				height: piece.image.height,
				alt: isMine ? 'Watercolour portrait of Jecisc, a red dragon' : `Jecisc, a red dragon, drawn by ${piece.artist}`,
				caption: isMine ? 'Watercolour by me' : `Me, by ${piece.artist}`,
			};
		}),
);
const sleepingSticker = artworkById('sticker-sleep-plush');
const peekingSticker = artworkById('sticker-brick');
/* Once caught, the peeking sticker takes the place of the portrait, so it needs a copy at the size of the portrait too */
const caughtSticker = peekingSticker && (await getImage({ src: peekingSticker.image, width: 900 }));
/* Petting the portrait: after this many pets in a row, I react with this sticker and caption. The last one means "enough". The sticker covers 42% of the portrait. */
const petReactions = await Promise.all(
	[
		{ pets: 3, id: 'sticker-tongue', caption: "Hehe. Okay, that's nice." },
		{ pets: 8, id: 'sticker-good-boy', caption: "Who's a good boy? Me. Obviously." },
		{ pets: 14, id: 'sticker-crossed-arms', caption: "That's enough. I have a reputation." },
	].flatMap((reaction) => {
		const sticker = artworkById(reaction.id);
		return sticker ? [getImage({ src: sticker.image, width: 400 }).then((resized) => ({ pets: reaction.pets, file: resized.src, caption: reaction.caption }))] : [];
	}),
);
const artSection = artworks.filter((piece) => piece.section === 'art');
const spotlightPiece = artSection.find((piece) => 'featured' in piece && piece.featured);
const artGrid = artSection.filter((piece) => piece !== spotlightPiece);
const stickerSection = artworks.filter((piece) => piece.section === 'stickers');
const year = new Date().getFullYear();
---

<Layout title={`${content.name} · red dragon from the north of France`} description={content.intro}>
	<SiteHeader />

	<main id="main">
		<section class="hero" id="top">
			<div class="wrap">
				<div>
					<p class="eyebrow">Red dragon · North of France</p>
					<h1 class="gradient-text">{content.name}</h1>
					<p class="hero-tagline">{content.tagline}</p>
					<div class="hero-actions">
						<a class="button button--primary" href="#art">See the art</a>
						<a class="button" href="#stickers">Grab a sticker</a>
					</div>
				</div>
				{
					heroPiece && (
						<figure class="hero-portrait" id="hero-portrait" data-hero-choices={JSON.stringify(heroChoices)} data-pet-reactions={JSON.stringify(petReactions)} data-hero-sizes={heroSizes}>
							<div class="hero-frame">
								<img class="hero-awake" alt="" />
								<noscript>
									<Image class="hero-awake" src={heroPiece.image} widths={heroWidths} sizes={heroSizes} alt="Watercolour portrait of Jecisc, a red dragon" />
								</noscript>
								{sleepingSticker && <Image class="hero-asleep" src={sleepingSticker.image} widths={heroWidths} sizes={heroSizes} alt="" aria-hidden="true" />}
							</div>
							<img class="hero-reaction" alt="" aria-hidden="true" draggable="false" />
							<figcaption>
								<span class="caption-awake">Watercolour by me</span>
								<span class="caption-asleep">Shh. I'm napping. Move to wake me up.</span>
								<span class="caption-caught">You caught me! I'll stay here until you refresh the page.</span>
								<span class="caption-pet"></span>
							</figcaption>
							{/* Runs while the page is parsed, so only the chosen image is downloaded and nothing flickers */}
							<script is:inline>
								(() => {
									const figure = document.currentScript.closest('figure');
									const choices = JSON.parse(figure.dataset.heroChoices);
									const choice = choices[Math.floor(Math.random() * choices.length)];
									const image = figure.querySelector('.hero-awake');
									image.width = choice.width;
									image.height = choice.height;
									image.alt = choice.alt;
									image.sizes = figure.dataset.heroSizes;
									image.srcset = choice.srcset;
									image.src = choice.src;
									figure.style.setProperty('--hero-ratio', `${choice.width} / ${choice.height}`);
									figure.querySelector('.caption-awake').textContent = choice.caption;
								})();
							</script>
						</figure>
					)
				}
			</div>
		</section>

		<div class="brick-ledge" aria-hidden="true">
			<picture class="ledge-dancer">
				<source srcset="/decor/bmo-still.webp" media="(prefers-reduced-motion: reduce)" />
				<img src="/decor/bmo-dancing.webp" alt="" width="89" height="103" draggable="false" />
			</picture>
			<div class="brick-divider"></div>
		</div>

		<section class="section" id="character">
			<div class="wrap character-grid">
				<div>
					<p class="eyebrow">The dragon</p>
					<h2 class="gradient-text">Character</h2>
					{content.description.map((paragraph) => <p>{paragraph}</p>)}
					<h3 class="palette-title">My colours</h3>
					<ul class="palette">
						{content.palette.map((swatch) => (
							<li>
								<button type="button" class="palette-chip" data-copy={swatch.colour} aria-label={`Copy the ${swatch.part.toLowerCase()} colour ${swatch.colour}`}>
									<span class="palette-swatch" style={`--swatch: ${swatch.colour}`} aria-hidden="true" />
									<span class="palette-part">{swatch.part}</span>
									<code class="palette-code" data-copy-feedback>{swatch.colour}</code>
								</button>
							</li>
						))}
					</ul>
				</div>
				<dl class="facts">
					<dt>Species</dt>
					<dd>Red dragon</dd>
					<dt>From</dt>
					<dd>The north of France</dd>
					<dt>Traits</dt>
					<dd>
						<ul class="tag-list">
							{content.traits.map((trait) => <li>{trait}</li>)}
						</ul>
					</dd>
					<dt>Outfits</dt>
					<dd>
						<ul class="tag-list tag-list--warm">
							{content.outfits.map((outfit) => <li>{outfit}</li>)}
						</ul>
					</dd>
				</dl>
			</div>
		</section>

		<div class="brick-divider" aria-hidden="true"></div>

		<section class="section" id="art">
			<div class="wrap">
				<p class="eyebrow">The art hoard</p>
				<h2 class="gradient-text">Art</h2>
				<p class="section-intro">{content.artIntro}</p>
				{spotlightPiece && <Spotlight piece={spotlightPiece} />}
				<Gallery pieces={artGrid} />
			</div>
		</section>

		<div class="brick-divider" aria-hidden="true"></div>

		<section class="section" id="stickers">
			<div class="wrap">
				<p class="eyebrow">The sticker pack</p>
				<h2 class="gradient-text">Stickers</h2>
				<p class="section-intro">{content.stickersIntro}</p>
				<p class="section-actions">
					<a class="button button--primary" href={content.stickerPackUrl} target="_blank" rel="noopener noreferrer">Add the pack on Telegram</a>
				</p>
				<Gallery pieces={stickerSection} layout="grid" />
			</div>
		</section>

		<div class="brick-divider" aria-hidden="true"></div>

		<section class="section" id="links">
			<div class="wrap">
				<p class="eyebrow">Find me</p>
				<h2 class="gradient-text">Links</h2>
				<p class="section-intro">{content.linksIntro}</p>
				<ul class="link-list">
					{content.socials.map((social) => {
						const note = 'note' in social ? `${social.note} · ` : '';
						const details = (
							<Fragment>
								<SocialIcon network={social.network} />
								<span class="link-network">{social.network}</span>
								<span class="link-handle">{social.handle}</span>
							</Fragment>
						);
						return (
							<li>
								{'url' in social ? (
									<a class="link-card" href={social.url} target="_blank" rel="me noopener noreferrer">
										{details}
										<span class="link-action">{note}Open profile</span>
									</a>
								) : (
									<button type="button" class="link-card" data-copy={social.handle} aria-label={`Copy ${social.network} username ${social.handle}`}>
										{details}
										<span class="link-action" data-copy-feedback>{note}Copy username</span>
									</button>
								)}
							</li>
						);
					})}
				</ul>
			</div>
		</section>
	</main>

	{
		peekingSticker && (
			<div class="peeker" id="peeker" aria-hidden="true">
				{/* The peeker is at most 9rem wide */}
				<Image src={peekingSticker.image} widths={[160, 320]} sizes="9rem" alt="" draggable="false" data-caught-src={caughtSticker?.src} />
			</div>
		)
	}
	<Hoard />

	<footer class="site-footer">
		<div class="wrap">
			<span>© {year} · {content.name}</span>
			<span id="hoard-count" aria-live="polite">{content.footerNote}</span>
			{/* Filled by the script in Layout.astro, so it stays hidden without JavaScript */}
			<details class="secrets" id="secrets" hidden>
				<summary></summary>
				<ul class="secrets-list"></ul>
			</details>
		</div>
	</footer>
</Layout>
