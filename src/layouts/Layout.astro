---
import '../styles/global.css';

interface Props {
	title: string;
	description: string;
	image?: string;
}

const { title, description, image } = Astro.props;
---

<!doctype html>
<html lang="en" data-theme="dark">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="description" content={description} />
		<meta name="theme-color" content="#12090f" />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		{image && <meta property="og:image" content={image} />}
		<link rel="icon" href="/favicon.ico" sizes="any" />
		<link rel="icon" type="image/png" href="/favicon.png" />
		<link rel="apple-touch-icon" href="/apple-touch-icon.png" />
		<title>{title}</title>
		<script is:inline>
			try {
				if (localStorage.getItem('site-theme') === 'light') {
					document.documentElement.dataset.theme = 'light';
				}
				if (localStorage.getItem('site-hoard') === 'hidden') {
					document.documentElement.dataset.hoard = 'hidden';
				}
			} catch (error) {}
		</script>
	</head>
	<body>
		<a class="skip-link" href="#main">Skip to content</a>
		<slot />
		<dialog class="zoom-dialog" id="zoom-dialog" aria-label="Zoomed artwork">
			<figure class="zoom-card">
				<img class="zoom-image" alt="" />
				<figcaption class="zoom-caption"></figcaption>
			</figure>
			<button type="button" class="zoom-close" aria-label="Close">×</button>
			<button type="button" class="zoom-arrow zoom-previous" aria-label="Previous artwork">‹</button>
			<button type="button" class="zoom-arrow zoom-next" aria-label="Next artwork">›</button>
		</dialog>
		<p class="toast" id="toast" role="status"></p>
		<script>
			const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
			const root = document.documentElement;

			/* Short message at the top of the page for a few seconds */
			const toast = document.getElementById('toast');
			let toastTimer: number | undefined;
			const showToast = (html: string, duration: number) => {
				if (!toast) {
					return;
				}
				toast.innerHTML = html;
				toast.classList.add('is-visible');
				window.clearTimeout(toastTimer);
				toastTimer = window.setTimeout(() => toast.classList.remove('is-visible'), duration);
			};

			/*
			 * Secrets: each easter egg found is remembered in this browser, and the footer counts them.
			 * A new easter egg only needs a line in this list and a call to findSecret or announceSecret where it happens.
			 */
			const secrets = {
				hoard: 'Added a piece to my hoard',
				nap: 'Watched me fall asleep',
				caught: 'Caught me peeking',
				pet: 'Petted me',
				console: 'Fed me from the console',
				lost: 'Found my lost page',
			};
			type SecretId = keyof typeof secrets;
			const secretIds = Object.keys(secrets) as SecretId[];
			const secretsStorageKey = 'site-secrets';
			const isSecretId = (value: unknown): value is SecretId => secretIds.includes(value as SecretId);
			const readFoundSecrets = () => {
				try {
					const saved: unknown = JSON.parse(localStorage.getItem(secretsStorageKey) ?? '[]');
					return new Set(Array.isArray(saved) ? saved.filter(isSecretId) : []);
				} catch (error) {
					return new Set<SecretId>();
				}
			};
			const foundSecrets = readFoundSecrets();
			const secretsPanel = document.getElementById('secrets') as HTMLDetailsElement | null;

			const renderSecrets = () => {
				if (!secretsPanel) {
					return;
				}
				const summary = secretsPanel.querySelector('summary');
				const list = secretsPanel.querySelector('.secrets-list');
				if (summary) {
					summary.textContent = foundSecrets.size === secretIds.length ? 'All secrets found. You know me too well.' : `Secrets found: ${foundSecrets.size}/${secretIds.length}`;
				}
				list?.replaceChildren(
					...secretIds.map((id) => {
						const item = document.createElement('li');
						const isFound = foundSecrets.has(id);
						item.classList.toggle('is-found', isFound);
						item.textContent = isFound ? secrets[id] : '???';
						return item;
					}),
				);
				secretsPanel.hidden = false;
			};

			/* Remembers the secret and returns the toast line announcing it, or an empty string when it was already found */
			const findSecret = (id: SecretId) => {
				if (foundSecrets.has(id)) {
					return '';
				}
				foundSecrets.add(id);
				try {
					localStorage.setItem(secretsStorageKey, JSON.stringify([...foundSecrets]));
				} catch (error) {}
				renderSecrets();
				const progress = foundSecrets.size === secretIds.length ? "That's all of them!" : `${foundSecrets.size}/${secretIds.length}`;
				return `<span class="toast-secret">Secret found: ${secrets[id]} · ${progress}</span>`;
			};

			const announceSecret = (id: SecretId) => {
				const line = findSecret(id);
				if (line) {
					showToast(line, 4000);
				}
			};

			renderSecrets();
			/* A page can be a secret by itself, like the 404 page */
			const pageSecret = document.querySelector<HTMLElement>('[data-secret]')?.dataset.secret;
			if (isSecretId(pageSecret)) {
				announceSecret(pageSecret);
			}

			/* Theme: dark ("hot chocolate time") by default, light ("daylight") on request */
			const themeToggle = document.getElementById('theme-toggle') as HTMLButtonElement | null;
			const themeToggleLabel = themeToggle?.querySelector('.theme-toggle-label');
			const currentTheme = () => (root.dataset.theme === 'light' ? 'light' : 'dark');
			const syncThemeToggle = () => {
				if (!themeToggle || !themeToggleLabel) {
					return;
				}
				const isDark = currentTheme() === 'dark';
				themeToggleLabel.textContent = isDark ? 'Back to daylight' : 'Hot chocolate time';
				themeToggle.setAttribute('aria-label', isDark ? 'Switch to light theme' : 'Switch to dark theme');
			};

			themeToggle?.addEventListener('click', () => {
				const nextTheme = currentTheme() === 'dark' ? 'light' : 'dark';
				root.dataset.theme = nextTheme;
				try {
					localStorage.setItem('site-theme', nextTheme);
				} catch (error) {}
				syncThemeToggle();
			});
			syncThemeToggle();

			/* Decorations (hoard and peeking dragon) can be hidden for accessibility */
			const hoardToggle = document.getElementById('hoard-toggle') as HTMLButtonElement | null;
			const decorationsHidden = () => root.dataset.hoard === 'hidden';
			const syncHoardToggle = () => {
				if (hoardToggle) {
					hoardToggle.textContent = decorationsHidden() ? 'Show decorations' : 'Hide decorations';
				}
			};

			hoardToggle?.addEventListener('click', () => {
				const nextState = decorationsHidden() ? 'shown' : 'hidden';
				if (nextState === 'hidden') {
					root.dataset.hoard = 'hidden';
					hidePeeker();
				} else {
					delete root.dataset.hoard;
				}
				try {
					localStorage.setItem('site-hoard', nextState);
				} catch (error) {}
				syncHoardToggle();
			});
			syncHoardToggle();

			/* Clicking a coin or a chocolate drops a new piece on the hoard */
			const hoardSvg = document.querySelector<SVGSVGElement>('.hoard-svg');
			const hoardCount = document.getElementById('hoard-count');
			const svgNamespace = 'http://www.w3.org/2000/svg';
			const coinMarkup =
				'<ellipse cx="0" cy="3" rx="20" ry="7" fill="#8a5a00"/><ellipse cx="0" cy="0" rx="20" ry="7" fill="url(#gold)" stroke="#b07a10" stroke-width="1"/><ellipse cx="0" cy="-1" rx="11" ry="3.8" fill="none" stroke="#fff3b0" stroke-opacity="0.7" stroke-width="1"/>';
			const chocolateMarkup =
				'<rect x="-22" y="-10" width="44" height="20" rx="3" fill="url(#choc)" stroke="#2a150a" stroke-width="1.2"/><path d="M-22 0 H22 M-8 -10 V10 M8 -10 V10" stroke="#2a150a" stroke-width="1.1" opacity="0.85"/>';
			let droppedPieces = 0;

			/* Height of the pile at x, the same profile used to generate Hoard.astro */
			const pileTopAt = (x: number) => 6 + 78 * Math.exp(-(((x - 1200) / 560) ** 2));

			/* Converts a point of the window into the coordinates of the hoard drawing */
			const toHoardPoint = (clientX: number, clientY: number) => {
				const matrix = hoardSvg?.getScreenCTM();
				return matrix ? new DOMPoint(clientX, clientY).matrixTransform(matrix.inverse()) : null;
			};

			/* Adds a piece that lands on the pile near x, falling from fromY (in hoard coordinates), or from just above the pile when not given */
			const dropPiece = (x: number, isChocolate: boolean, fromY?: number) => {
				if (!hoardSvg) {
					return;
				}
				const restX = Math.min(2380, Math.max(20, x + (Math.random() * 40 - 20)));
				const restY = 97 - pileTopAt(restX) * (0.75 + Math.random() * 0.25);
				const startY = Math.min(fromY ?? restY - 240, restY - 10);
				const piece = document.createElementNS(svgNamespace, 'g');
				piece.innerHTML = isChocolate ? chocolateMarkup : coinMarkup;
				piece.setAttribute('transform', `translate(${restX} ${restY})`);
				hoardSvg.appendChild(piece);
				if (!prefersReducedMotion.matches) {
					piece.animate(
						[
							{ transform: `translate(${restX}px, ${startY}px)` },
							{ transform: `translate(${restX}px, ${restY}px)`, offset: 0.8 },
							{ transform: `translate(${restX}px, ${restY - 10}px)`, offset: 0.9 },
							{ transform: `translate(${restX}px, ${restY}px)` },
						],
						{ duration: 800 * Math.sqrt(Math.max(1, (restY - startY) / 240)), easing: 'ease-in' },
					);
				}
			};

			hoardSvg?.addEventListener('click', (event) => {
				const clicked = toHoardPoint(event.clientX, event.clientY);
				if (!clicked) {
					return;
				}
				dropPiece(clicked.x, Math.random() < 0.2);
				droppedPieces += 1;
				if (hoardCount) {
					hoardCount.textContent = `${droppedPieces} ${droppedPieces === 1 ? 'piece' : 'pieces'} added to my hoard. Thank you, I'll take good care of them.`;
				}
				announceSecret('hoard');
			});

			/* Jecisc falls asleep in the hero after a while without activity */
			const heroPortrait = document.getElementById('hero-portrait');
			let idleTimer: number | undefined;
			const wakeUp = () => {
				heroPortrait?.classList.remove('is-asleep');
				window.clearTimeout(idleTimer);
				idleTimer = window.setTimeout(() => {
					heroPortrait?.classList.add('is-asleep');
					announceSecret('nap');
				}, 30000);
			};
			if (heroPortrait) {
				['pointermove', 'pointerdown', 'keydown', 'scroll', 'touchstart'].forEach((eventName) => window.addEventListener(eventName, wakeUp, { passive: true }));
				wakeUp();
			}

			/*
			 * Petting the portrait: each click sends a heart, and enough pets in a row bring a reaction sticker and a caption.
			 * The last reaction means "that's enough": I ignore pets for a few seconds, then everything goes back to normal.
			 */
			const petReactions: { pets: number; file: string; caption: string }[] = JSON.parse(heroPortrait?.dataset.petReactions ?? '[]');
			const heroFrame = heroPortrait?.querySelector('.hero-frame');
			const reactionImage = heroPortrait?.querySelector<HTMLImageElement>('.hero-reaction');
			const petCaption = heroPortrait?.querySelector('.caption-pet');
			let petCount = 0;
			let isFedUp = false;
			let petResetTimer: number | undefined;

			const stopPetting = () => {
				petCount = 0;
				isFedUp = false;
				heroPortrait?.classList.remove('is-petted');
			};

			const sendHeart = (x: number, y: number) => {
				if (prefersReducedMotion.matches) {
					return;
				}
				const heart = document.createElement('span');
				heart.className = 'pet-heart';
				heart.textContent = '♥';
				heart.setAttribute('aria-hidden', 'true');
				heart.style.left = `${x}px`;
				heart.style.top = `${y}px`;
				heart.style.setProperty('--drift', `${Math.random() * 40 - 20}px`);
				heart.addEventListener('animationend', () => heart.remove());
				document.body.append(heart);
			};

			heroFrame?.addEventListener('click', (event) => {
				if (!heroPortrait || !reactionImage || !petCaption || isFedUp) {
					return;
				}
				petCount += 1;
				sendHeart(event.clientX, event.clientY);
				if (petCount === 1) {
					/* Loads the stickers early so they show at once */
					petReactions.forEach((reaction) => {
						new Image().src = reaction.file;
					});
				}
				const reaction = petReactions.find((candidate) => candidate.pets === petCount);
				if (reaction) {
					reactionImage.src = reaction.file;
					petCaption.textContent = reaction.caption;
					heroPortrait.classList.add('is-petted');
					if (!prefersReducedMotion.matches) {
						reactionImage.animate([{ scale: 0.7 }, { scale: 1 }], { duration: 350, easing: 'cubic-bezier(0.2, 0.8, 0.2, 1.4)' });
					}
					isFedUp = reaction === petReactions[petReactions.length - 1];
					announceSecret('pet');
				}
				window.clearTimeout(petResetTimer);
				petResetTimer = window.setTimeout(stopPetting, isFedUp ? 6000 : 2500);
			});

			/*
			 * Now and then, Jecisc peeks from behind his hoard.
			 * Come close and he runs away from the cursor, anywhere in the window, then leaves after 15 seconds.
			 * Each jump makes him a bit more tired (a longer pause before he can jump again), so a quick player can catch him.
			 * Once caught, he replaces the portrait at the top of the page until the page is reloaded.
			 */
			const peeker = document.getElementById('peeker');
			const runDuration = 15000;
			const fleeRadius = 60;
			let peekerState: 'hidden' | 'peeking' | 'running' | 'leaving' | 'caught' = 'hidden';
			let duckTimer: number | undefined;
			let escapeTimer: number | undefined;
			let coinTrailTimer: number | undefined;
			let fleeCount = 0;
			let fleeCooldownEnd = 0;

			const withoutTransition = (change: () => void) => {
				if (!peeker) {
					return;
				}
				peeker.style.transition = 'none';
				change();
				peeker.getBoundingClientRect();
				peeker.style.transition = '';
			};

			const movePeekerTo = (x: number, y: number) => {
				peeker?.style.setProperty('--x', `${x}px`);
				peeker?.style.setProperty('--y', `${y}px`);
			};

			/* While running, he loses coins from his pockets: they fall from where he is into the pile */
			const dropCoinsFromPeeker = (count: number) => {
				if (!peeker) {
					return;
				}
				const rect = peeker.getBoundingClientRect();
				const origin = toHoardPoint(rect.left + rect.width / 2, rect.top + rect.height * 0.7);
				if (!origin) {
					return;
				}
				for (let index = 0; index < count; index++) {
					dropPiece(origin.x, false, origin.y);
				}
			};

			const stopCoinTrail = () => window.clearInterval(coinTrailTimer);

			function hidePeeker() {
				if (!peeker || peekerState === 'caught') {
					return;
				}
				window.clearTimeout(duckTimer);
				window.clearTimeout(escapeTimer);
				stopCoinTrail();
				withoutTransition(() => peeker.classList.remove('is-peeking', 'is-running'));
				peekerState = 'hidden';
			}

			function peek() {
				if (!peeker || peekerState === 'caught') {
					return;
				}
				if (peekerState === 'hidden' && !document.hidden && !decorationsHidden() && !prefersReducedMotion.matches) {
					peekerState = 'peeking';
					peeker.classList.add('is-peeking');
					duckTimer = window.setTimeout(() => {
						peeker.classList.remove('is-peeking');
						peekerState = 'hidden';
					}, 4500);
				}
				window.setTimeout(peek, 25000 + Math.random() * 20000);
			}

			const startRunning = () => {
				if (!peeker) {
					return;
				}
				window.clearTimeout(duckTimer);
				const rect = peeker.getBoundingClientRect();
				withoutTransition(() => {
					peeker.classList.replace('is-peeking', 'is-running');
					movePeekerTo(rect.left, rect.top);
				});
				peekerState = 'running';
				fleeCount = 0;
				escapeTimer = window.setTimeout(leave, runDuration);
				coinTrailTimer = window.setInterval(() => dropCoinsFromPeeker(1), 600);
			};

			/* Jumps to a random place far enough from the pointer, below the header and above the bottom edge */
			const flee = (pointerX: number, pointerY: number) => {
				if (!peeker) {
					return;
				}
				const { width, height } = peeker.getBoundingClientRect();
				const margin = 16;
				const top = 72;
				const minimumDistance = Math.min(window.innerWidth, window.innerHeight) * 0.4;
				let destination = { x: 0, y: 0 };
				let destinationDistance = -1;
				for (let attempt = 0; attempt < 12 && destinationDistance < minimumDistance; attempt++) {
					const x = margin + Math.random() * Math.max(0, window.innerWidth - width - 2 * margin);
					const y = top + Math.random() * Math.max(0, window.innerHeight - height - top - margin);
					const distance = Math.hypot(x + width / 2 - pointerX, y + height / 2 - pointerY);
					if (distance > destinationDistance) {
						destination = { x, y };
						destinationDistance = distance;
					}
				}
				dropCoinsFromPeeker(2);
				movePeekerTo(destination.x, destination.y);
				fleeCount += 1;
				fleeCooldownEnd = performance.now() + Math.min(1200, 250 + fleeCount * 60);
			};

			const canFlee = () => (peekerState === 'peeking' || peekerState === 'running') && performance.now() >= fleeCooldownEnd;

			const runAwayFrom = (pointerX: number, pointerY: number) => {
				if (peekerState === 'peeking') {
					startRunning();
				}
				flee(pointerX, pointerY);
			};

			function leave() {
				if (!peeker || peekerState !== 'running') {
					return;
				}
				peekerState = 'leaving';
				stopCoinTrail();
				const rect = peeker.getBoundingClientRect();
				const exitsLeft = rect.left + rect.width / 2 < window.innerWidth / 2;
				movePeekerTo(exitsLeft ? -rect.width * 1.5 : window.innerWidth + rect.width * 0.5, rect.top);
				escapeTimer = window.setTimeout(hidePeeker, 700);
			}

			const catchPeeker = () => {
				if (!peeker) {
					return;
				}
				peekerState = 'caught';
				window.clearTimeout(duckTimer);
				window.clearTimeout(escapeTimer);
				stopCoinTrail();
				dropCoinsFromPeeker(5);
				peeker.classList.add('is-caught');
				window.setTimeout(() => peeker.remove(), 400);
				const portraitImage = heroPortrait?.querySelector<HTMLImageElement>('.hero-awake');
				const stickerImage = peeker.querySelector('img');
				if (heroPortrait && portraitImage && stickerImage) {
					portraitImage.src = stickerImage.src;
					portraitImage.alt = 'Jecisc peeking over a brick wall, caught by you';
					heroPortrait.classList.add('is-caught');
				}
				showToast(`You caught me! <a href="#top">I now guard the top of the page</a> until you refresh.${findSecret('caught')}`, 7000);
			};

			if (peeker) {
				document.addEventListener('pointermove', (event) => {
					if (event.pointerType === 'touch' || !canFlee()) {
						return;
					}
					const rect = peeker.getBoundingClientRect();
					const distance = Math.hypot(event.clientX - (rect.left + rect.width / 2), event.clientY - (rect.top + rect.height / 2));
					if (distance <= rect.width / 2 + fleeRadius) {
						runAwayFrom(event.clientX, event.clientY);
					}
				});
				/* Without hover on touch screens, a tap is the attempt: he dodges it unless he is still catching his breath */
				peeker.addEventListener('pointerdown', (event) => {
					event.preventDefault();
					if (peekerState === 'hidden' || peekerState === 'caught') {
						return;
					}
					if (event.pointerType === 'touch' && canFlee()) {
						runAwayFrom(event.clientX, event.clientY);
					} else {
						catchPeeker();
					}
				});
				window.setTimeout(peek, 10000 + Math.random() * 8000);
			}

			/* For the curious who open the developer tools: a hello, and a command that feeds me chocolate */
			console.log('%cJecisc 🐉', 'font: 700 24px Georgia, serif; color: #fb7c38; text-shadow: 0 0 8px #d65234;');
			console.log("Looking at my code? It's on GitHub: https://github.com/jecisc/furry-website\nThe gold stays here, though.\n\nPsst. Type feedJecisc() and press Enter.");
			let chocolatesEaten = 0;
			const feedJecisc = () => {
				chocolatesEaten += 1;
				if (!decorationsHidden()) {
					for (let index = 0; index < 5; index++) {
						dropPiece(600 + Math.random() * 1200, true);
					}
				}
				announceSecret('console');
				return chocolatesEaten === 1 ? 'Nom. Chocolate is the way to my heart.' : `Nom. That makes ${chocolatesEaten * 5} chocolates. Keep them coming.`;
			};
			Object.assign(window, { feedJecisc });

			/* Buttons that copy a text (a username, a colour code): their [data-copy-feedback] element briefly says whether it worked */
			document.querySelectorAll<HTMLButtonElement>('[data-copy]').forEach((button) => {
				const feedback = button.querySelector('[data-copy-feedback]');
				const feedbackText = feedback?.textContent ?? '';
				let resetTimer: number | undefined;
				button.addEventListener('click', async () => {
					if (!feedback) {
						return;
					}
					try {
						await navigator.clipboard.writeText(button.dataset.copy ?? '');
						feedback.textContent = 'Copied!';
						button.classList.add('is-copied');
					} catch (error) {
						feedback.textContent = 'Copy failed';
					}
					window.clearTimeout(resetTimer);
					resetTimer = window.setTimeout(() => {
						feedback.textContent = feedbackText;
						button.classList.remove('is-copied');
					}, 2000);
				});
			});

			/* Gated artworks */
			document.querySelectorAll<HTMLButtonElement>('[data-reveal]').forEach((button) => {
				button.addEventListener('click', () => {
					button.closest('figure')?.classList.remove('is-blurred');
					button.remove();
				});
			});

			/* Zoom dialog */
			const zoomDialog = document.getElementById('zoom-dialog') as HTMLDialogElement;
			const zoomImage = zoomDialog.querySelector('.zoom-image') as HTMLImageElement;
			const zoomCaption = zoomDialog.querySelector('.zoom-caption') as HTMLElement;
			const zoomPrevious = zoomDialog.querySelector('.zoom-previous') as HTMLButtonElement;
			const zoomNext = zoomDialog.querySelector('.zoom-next') as HTMLButtonElement;
			const zoomClose = zoomDialog.querySelector('.zoom-close') as HTMLButtonElement;

			let zoomItems: HTMLButtonElement[] = [];
			let zoomIndex = 0;

			const isBlurred = (button: HTMLButtonElement) => Boolean(button.closest('figure')?.classList.contains('is-blurred'));

			const showZoomItem = (index: number) => {
				zoomIndex = (index + zoomItems.length) % zoomItems.length;
				const button = zoomItems[zoomIndex];
				zoomImage.src = button.dataset.zoom ?? '';
				zoomImage.alt = button.dataset.alt ?? '';
				const artist = button.dataset.artist ?? '';
				const artistUrl = button.dataset.artistUrl;
				if (artistUrl) {
					const link = document.createElement('a');
					link.className = 'artist-link';
					link.href = artistUrl;
					link.target = '_blank';
					link.rel = 'noopener noreferrer';
					link.textContent = artist;
					zoomCaption.replaceChildren('by ', link);
				} else {
					zoomCaption.textContent = `by ${artist}`;
				}
				const hasSeveral = zoomItems.length > 1;
				zoomPrevious.hidden = !hasSeveral;
				zoomNext.hidden = !hasSeveral;
			};

			const openZoom = (button: HTMLButtonElement) => {
				const section = button.closest('section') ?? document;
				zoomItems = [...section.querySelectorAll<HTMLButtonElement>('[data-zoom]')].filter((item) => !isBlurred(item));
				showZoomItem(zoomItems.indexOf(button));
				zoomDialog.showModal();
			};

			document.querySelectorAll<HTMLButtonElement>('[data-zoom]').forEach((button) => {
				button.addEventListener('click', () => {
					if (!isBlurred(button)) {
						openZoom(button);
					}
				});
			});

			zoomPrevious.addEventListener('click', () => showZoomItem(zoomIndex - 1));
			zoomNext.addEventListener('click', () => showZoomItem(zoomIndex + 1));
			zoomClose.addEventListener('click', () => zoomDialog.close());
			zoomDialog.addEventListener('click', (event) => {
				if (event.target === zoomDialog) {
					zoomDialog.close();
				}
			});
			document.addEventListener('keydown', (event) => {
				if (!zoomDialog.open) {
					return;
				}
				if (event.key === 'ArrowLeft') {
					showZoomItem(zoomIndex - 1);
				} else if (event.key === 'ArrowRight') {
					showZoomItem(zoomIndex + 1);
				}
			});
		</script>
	</body>
</html>
