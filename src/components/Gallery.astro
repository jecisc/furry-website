---
import ArtistName from './ArtistName.astro';
import artists from '../data/artists.json';

interface Piece {
	id: string;
	file: string;
	artist: string;
	section: string;
	gate: string;
	width: number;
	height: number;
}

interface Props {
	pieces: Piece[];
	/**
	 * "justified" keeps each artwork's own shape in rows that fill the width.
	 * "grid" gives every piece the same size, which suits the square stickers.
	 */
	layout?: 'justified' | 'grid';
}

const { pieces, layout = 'justified' } = Astro.props;
---

<ul class:list={['gallery', `gallery--${layout}`]}>
	{
		pieces.map((piece) => {
			const isGated = piece.gate !== 'none';
			const artist = piece.artist.trim();
			const alt = `Artwork of Jecisc by ${artist}`;
			return (
				<li style={`--ratio: ${(piece.width / piece.height).toFixed(4)}`}>
					<figure class:list={['piece', isGated && 'is-blurred']}>
						<div class="piece-frame">
							<button type="button" class="zoom" data-zoom={piece.file} data-alt={alt} data-artist={artist} data-artist-url={(artists as Record<string, string>)[artist]}>
								<img src={piece.file} alt={alt} width={piece.width} height={piece.height} loading="lazy" />
							</button>
							{isGated && (
								<button type="button" class="reveal" data-reveal>
									Peek (18+)
								</button>
							)}
						</div>
						<figcaption>
							by <ArtistName artist={artist} />
						</figcaption>
					</figure>
				</li>
			);
		})
	}
</ul>
