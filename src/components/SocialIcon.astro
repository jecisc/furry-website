---
/**
 * Logo of a social network, drawn in the network's colour on a tinted square.
 * In the light theme the square is filled with the network's colour instead, and the logo is drawn in white, or in black on light colours.
 * The logos come from Simple Icons (https://simpleicons.org, CC0): version 16.38.1, and 10.4.0 for the old Twitter bird.
 * Barq! is not in Simple Icons, so it gets a paw instead.
 */
interface Props {
	/** Network name as written in content.json, for example "Telegram" */
	network: string;
}

