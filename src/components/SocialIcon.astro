const colours: Record<string, string> = {
	Telegram: '#26a5e4',
	Discord: '#5865f2',
	Twitter: '#1da1f2',
	GitHub: 'var(--ink)',
	Snapchat: '#fffc00',
	'Barq!': 'var(--pink)',
};

/* Logo colour on the filled square of the light theme, for the networks whose colour is too light for white */
const logoColours: Record<string, string> = {
	Snapchat: '#000000',
};

const { network } = Astro.props;
const path = paths[network];
---

{
	path && (
		<span class="link-icon" style={`--brand: ${colours[network] ?? 'var(--pink)'}; --brand-logo: ${logoColours[network] ?? '#ffffff'}`} aria-hidden="true">
			<svg viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg" focusable="false">
				<path d={path} />
			</svg>
		</span>
	)
}
