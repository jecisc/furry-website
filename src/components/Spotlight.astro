---
import { Image } from 'astro:assets';
import ArtistName from './ArtistName.astro';
import artists from '../data/artists.json';
import type { Artwork } from '../data/artworks';

interface Props {
	piece: Artwork;
}

const { piece } = Astro.props;
const isGated = piece.gate !== 'none';
const artist = piece.artist.trim();
const alt = `Artwork of Jecisc by ${artist}`;
---

<div class="spotlight">
	<figure class:list={['spotlight-figure', isGated && 'is-blurred']} style={`--ratio: ${(piece.image.width / piece.image.height).toFixed(4)}`}>
		<div class="spotlight-frame">
			<button type="button" class="zoom" data-zoom={piece.image.src} data-alt={alt} data-artist={artist} data-artist-url={(artists as Record<string, string>)[artist]}>
				{/* About 38rem wide next to its text from 800px, the full width below */}
				<Image src={piece.image} widths={[600, 1000]} sizes="(min-width: 800px) 38rem, 92vw" alt={alt} loading="lazy" />
			</button>
			{
				isGated && (
					<button type="button" class="reveal" data-reveal>
						Peek (18+)
					</button>
				)
			}
		</div>
	</figure>
	<div class="spotlight-text">
		<p class="eyebrow">Spotlight</p>
		<h3>The one that set the mood</h3>
		<p>
			By <ArtistName artist={artist} />. I love its neon glow and late-night colours so much that they inspired the whole look of my site.
		</p>
	</div>
</div>
